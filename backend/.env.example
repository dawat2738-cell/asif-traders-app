# Copy to .env on the host (never commit real secrets).
# FREE design defaults: SMS OTP is OFF. Only set SMS_OTP_ENABLED=true
# if the shop owner later chooses a paid SMS provider account.
HOST=0.0.0.0
# PORT is set automatically by most free hosts; set it only when running manually.
# PORT=3000
DB_PATH=backend/data/shop.db
IMAGES_DIR=../products
BANNER_PATH=../shop-banner.png
PROFILE_PATH=../shop-profile.png
SESSION_DAYS=30
SMS_OTP_ENABLED=false
# Only needed if SMS_OTP_ENABLED=true (paid SMS provider, later stage):
# SMS_PROVIDER=http
# SMS_API_URL=
# SMS_API_KEY=
SMS_SENDER_ID=AsifTraders
# TEST_MODE must NEVER be 1 in production.
# TEST_MODE=0
